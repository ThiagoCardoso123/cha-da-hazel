# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes na hospedagem.
# Nenhum destes valores é segredo: os dois primeiros são públicos por natureza.
# NUNCA coloque aqui a chave service_role / secret do Supabase.

# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "anon" (ou "publishable", nos projetos novos)
VITE_SUPABASE_ANON_KEY=

# Endereço público do site, sem barra no final. É o que vira QR Code na TV.
# Ex.: https://chadahazel.vercel.app
VITE_PUBLIC_URL=
